{
  "version": 2,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__path__=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/abrigo",
      "destination": "/abrigo/index.html"
    }
  ]
}
